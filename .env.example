# Cổng chạy ứng dụng (Mặc định 3000)
PORT=3000

# Địa chỉ lắng nghe
HOST=0.0.0.0

# Số người tối đa trong một phòng (Mặc định 50)
MAX_PER_ROOM=50

# Số lượng phòng tối đa của toàn hệ thống (Mặc định 20)
MAX_ROOMS=20

# Thời gian tự động dọn phòng phụ khi không còn ai (phút)
ROOM_IDLE_MINUTES=5

# Cấu hình CORS cho Socket.IO (* hoặc tên miền frontend)
CORS_ORIGIN=*

# Môi trường chạy
NODE_ENV=production

# URL triển khai (nếu có)
APP_URL=https://chua-online.example.com
