# Cổng chạy ứng dụng (Mặc định 3000)
PORT=3000

# Địa chỉ lắng nghe
HOST=0.0.0.0

# Số người tối đa trong một phòng (Mặc định 50)
MAX_PER_ROOM=50

# Số lượng phòng tối đa của toàn hệ thống (Mặc định 20)
MAX_ROOMS=20

# Thời gian tự động dọn phòng phụ khi không còn ai (phút)
ROOM_IDLE_MINUTES=5

# Cấu hình CORS cho Socket.IO (* hoặc tên miền frontend)
CORS_ORIGIN=*

# Môi trường chạy
NODE_ENV=production

# URL triển khai (nếu có)
APP_URL=https://chua-online.example.com

# Server tự gọi chính nó mỗi 10 phút để Render bản miễn phí không ngủ.
# Trên Render tự lấy RENDER_EXTERNAL_URL, không cần đặt. Đặt KEEP_ALIVE=off để tắt.
# KEEP_ALIVE_URL=https://ten-web.onrender.com
# KEEP_ALIVE=off

# Mật khẩu trang quản trị (nút 🛡️ ở màn hình vào chùa, hoặc thêm #admin vào địa chỉ web).
# Không đặt = tắt trang quản trị. Đặt trên Render ở mục Environment, KHÔNG commit mật khẩu thật.
ADMIN_PASSWORD=duytam@2911
